# ============================================
# DATABASE CONFIGURATION
# ============================================

# Development Database
DATABASE_URL="postgresql://english_user:english_password@localhost:5432/english_app?schema=auth&connection_limit=5"

# Production Database with Connection Pooling
# DATABASE_URL="postgresql://english_user:english_password@pgbouncer-host:6432/english_app?schema=auth&connection_limit=5&pool_timeout=45"

# ============================================
# SERVICE CONFIGURATION
# ============================================
PORT=3002
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=604800

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
BCRYPT_ROUNDS=10
OTP_EXPIRY_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ============================================
# EXTERNAL SERVICES
# ============================================
# Email Service
EMAIL_SERVICE_URL="https://api.email-service.com"
EMAIL_SERVICE_KEY="your_email_key"

# SMS Service
SMS_SERVICE_URL="https://api.sms-service.com"
SMS_SERVICE_KEY="your_sms_key"

# ============================================
# REDIS CONFIGURATION (for session/token management)
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASSWORD=""

