# ============================================
# DATABASE CONFIGURATION
# ============================================

# Development Database
DATABASE_URL="postgresql://english_user:english_password@localhost:5432/english_app?schema=payment&connection_limit=5"

# Production Database with Connection Pooling
# DATABASE_URL="postgresql://english_user:english_password@pgbouncer-host:6432/english_app?schema=payment&connection_limit=5&pool_timeout=45"

# ============================================
# SERVICE CONFIGURATION
# ============================================
PORT=3005
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================
# Stripe/Razorpay or other payment provider
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY="your_provider_key"
PAYMENT_PROVIDER_SECRET="your_provider_secret"
PAYMENT_WEBHOOK_SECRET="your_webhook_secret"
PAYMENT_IDEMPOTENCY_TIMEOUT=3600

# ============================================
# REDIS CONFIGURATION (for payment state management)
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASSWORD=""

# ============================================
# KAFKA CONFIGURATION (for event publishing)
# ============================================
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="payment-service"

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=debug
ENABLE_TRANSACTION_LOGGING=true

