# ============================================
# DATABASE CONFIGURATION
# ============================================

# Development Database
DATABASE_URL="postgresql://english_user:english_password@localhost:5432/english_app?schema=user&connection_limit=5"

# Production Database with Connection Pooling
# DATABASE_URL="postgresql://english_user:english_password@pgbouncer-host:6432/english_app?schema=user&connection_limit=5&pool_timeout=45"

# ============================================
# SERVICE CONFIGURATION
# ============================================
PORT=3004
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASSWORD=""

# ============================================
# EXTERNAL SERVICES
# ============================================
B2_KEY_ID="your_placeholder_here"
B2_APPLICATION_KEY="your_placeholder_here"
B2_BUCKET_NAME="your_placeholder_here"
B2_ENDPOINT="your_placeholder_here"
B2_REGION="your_placeholder_here"

