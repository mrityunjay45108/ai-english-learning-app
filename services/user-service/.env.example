# ============================================
# DATABASE CONFIGURATION
# ============================================

# Development Database
DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@your-host.aivencloud.com:14892/defaultdb?sslmode=require"

# Production Database with Connection Pooling
# DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@your-host.aivencloud.com:14892/defaultdb?sslmode=require"

# ============================================
# SERVICE CONFIGURATION
# ============================================
PORT=3004
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_URL="redis://default:YOUR_PASSWORD@your-redis-host:16483"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASSWORD="YOUR_REDIS_PASSWORD"

# ============================================
# EXTERNAL SERVICES
# ============================================
B2_KEY_ID="your_placeholder_here"
B2_APPLICATION_KEY="your_placeholder_here"
B2_BUCKET_NAME="your_placeholder_here"
B2_ENDPOINT="your_placeholder_here"
B2_REGION="your_placeholder_here"

