# ============================================
# DATABASE CONFIGURATION
# ============================================

# Development Database
DATABASE_URL="postgresql://english_user:english_password@localhost:5432/english_app?schema=subscription&connection_limit=5"

# Production Database with Connection Pooling
# DATABASE_URL="postgresql://english_user:english_password@pgbouncer-host:6432/english_app?schema=subscription&connection_limit=5&pool_timeout=45"

# ============================================
# SERVICE CONFIGURATION
# ============================================
PORT=3006
NODE_ENV=development
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
LOG_LEVEL=debug

# ============================================
# SUBSCRIPTION MANAGEMENT
# ============================================
GRACE_PERIOD_DAYS=7
AUTO_RENEWAL_RETRY_DAYS=3
TRIAL_EXPIRY_NOTIFICATION_DAYS=3

# ============================================
# REDIS CONFIGURATION (for subscription state management)
# ============================================
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASSWORD=""

# ============================================
# KAFKA CONFIGURATION (for event publishing)
# ============================================
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="subscription-service"
KAFKA_GROUP_ID="subscription-service-group"

# ============================================
# EXTERNAL SERVICES
# ============================================
# Payment Service
PAYMENT_SERVICE_URL="http://localhost:3005"

# Notification Service
NOTIFICATION_SERVICE_URL="http://localhost:3009"

B2_ENDPOINT="your_placeholder_here"
B2_REGION="your_placeholder_here"
