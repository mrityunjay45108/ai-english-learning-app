# ============================================
# DATABASE CONFIGURATION
# ============================================

# Development Database
# Uses connection limit for safety
DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@your-host.aivencloud.com:14892/defaultdb?sslmode=require"

# Production Database with Connection Pooling
# Recommended: Use PgBouncer or AWS RDS Proxy
# DATABASE_URL="postgres://avnadmin:YOUR_PASSWORD@your-host.aivencloud.com:14892/defaultdb?sslmode=require"

# ============================================
# SERVICE CONFIGURATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
PORT=3007
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# CACHING CONFIGURATION
# ============================================
TOPIC_CACHE_TTL=3600          # Cache grammar topics for 1 hour
REDIS_URL="redis://default:YOUR_PASSWORD@your-redis-host:16483"

# ============================================
# REDIS CONFIGURATION (Optional)
# ============================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER="default"
REDIS_PASSWORD="YOUR_REDIS_PASSWORD"

# ============================================
# EXTERNAL SERVICES
# ============================================
B2_KEY_ID="your_placeholder_here"
B2_APPLICATION_KEY="your_placeholder_here"
B2_BUCKET_NAME="your_placeholder_here"
B2_ENDPOINT="your_placeholder_here"
B2_REGION="your_placeholder_here"

